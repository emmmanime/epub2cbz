      "help_output": "    -o, --output  -- set output directory path",
      "help_force": "    -f, --force   -- overwrite output files without confirmation",
      "help_verbose": "    -V, --verbose -- show detailed parsing and extraction logs",
      "file_exists": "Skip/Confirm: File already exists -> {filename}",
      "overwrite_prompt": "Overwrite[Y], Cancel[N], Overwrite all[U]? [Y/N/U]: ",
