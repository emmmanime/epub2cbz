      "html_parse_err": "     [Warning] HTML parsing failed: {item_path} ({ex})",
      "image_order_count": "  -> Retrieved {count} image orders from OPF spine and HTML.",
      "opf_parse_err": "  [Warning] OPF parsing error ({ex}). Falling back to filename sort.",
      "fallback_count": "  -> Fallback: Retrieved {count} images sorted by filename.",
      "cover_detected": "  -> [Cover Detected] Placing '{filename}' at the beginning (0000).",
      "final_page_list": "  -> Final page list (Total {count} pages):",
      "page_prefix": " [Cover]",
      "write_success": "     Write success: {img_name} -> {new_filename}",
      "file_not_found": "     [Warning] File not found: {img_name}",
      "done_short": "Done (Total {count} pages)",
      "done_verbose": "[Done] Output: {output_path}\n",
      "fail_short": "Failed",
      "fail_msg": "  [Error] Failed to convert {filename}: {ex}",
